{
    $schema: "https://raw.githubusercontent.com/infection/infection/0.34.2/resources/schema.json",
    source: {
        directories: ["src"],
    },
    logs: {
        text: "build/infection.log",
        stryker: {
            report: "main",
        },
    },
    // Only mutants that provably cannot be killed are ignored, each with the
    // argument for why. Anything that merely looks hard to kill is left in:
    // a surviving mutant is information, and silencing it throws that away.
    mutators: {
        "@default": true,

        // Box-Muller: cos(θ) has the same law for θ uniform over (0, 2π) as
        // over any (0, kπ) with k >= 1, so scaling the angle is unobservable.
        // The (1 + c·x) term is symmetric in x, which is standard normal, so
        // flipping that sign draws from the same distribution.
        IncrementInteger: {
            ignoreSourceCodeByRegex: [".*2\\.0 \\* M_PI.*", ".*getInt\\(1, self::DRAW_RANGE - 1\\).*"],
        },
        DecrementInteger: {
            ignoreSourceCodeByRegex: [".*2\\.0 \\* M_PI.*", ".*getInt\\(1, self::DRAW_RANGE - 1\\).*"],
        },
        Minus: {
            ignoreSourceCodeByRegex: [".*getInt\\(1, self::DRAW_RANGE - 1\\).*"],
        },
        Plus: {
            ignoreSourceCodeByRegex: [".*\\(1\\.0 \\+ \\$c \\* \\$x\\).*"],
        },
        // PHP_INT_SIZE cannot take its other branch on a 64-bit runner, and both
        // ends of the draw range guard events of probability 2^-53: a shifted
        // bound is not reachable by any finite number of draws.
        GreaterThanOrEqualTo: {
            ignoreSourceCodeByRegex: [".*PHP_INT_SIZE.*"],
        },
        LessThanOrEqualTo: {
            // v == 0.0 exactly has probability zero, and the acceptance test
            // below would reject it anyway through log(0).
            ignoreSourceCodeByRegex: [".*\\$v <= 0\\.0.*"],
        },
        LessThan: {
            // Likewise, the acceptance test turning strict into non-strict only
            // matters when log(u) lands exactly on the threshold.
            ignoreSourceCodeByRegex: [".*log\\(\\$u\\) <.*"],
        },
    },
}

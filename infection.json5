{
    $schema: "https://raw.githubusercontent.com/infection/infection/0.34.2/resources/schema.json",
    source: {
        directories: ["src"],
    },
    logs: {
        text: "build/infection.log",
        stryker: {
            report: "main",
        },
    },
    // The sampler has a handful of mutants no test can kill, because the mutated
    // code draws from the same distribution as the original. They are listed
    // here with the reason, rather than left to be re-investigated every run.
    mutators: {
        "@default": true,

        // Box-Muller: cos(θ) has the same law for θ uniform over (0, 2π) as over
        // any (0, kπ) with k >= 1, so scaling the angle changes nothing observable.
        // Marsaglia & Tsang's 1/3 and 9 are fixed by the derivation, and the
        // (1 + c·x) term is symmetric in x, which is standard normal.
        IncrementInteger: {
            ignoreSourceCodeByRegex: ["2\\.0 \\* M_PI.*", ".*1\\.0 \\/ 3\\.0.*", ".*sqrt\\(9\\.0.*"],
        },
        DecrementInteger: {
            ignoreSourceCodeByRegex: ["2\\.0 \\* M_PI.*", ".*1\\.0 \\/ 3\\.0.*", ".*sqrt\\(9\\.0.*"],
        },
        Minus: {
            ignoreSourceCodeByRegex: [".*getInt\\(1, self::DRAW_RANGE - 1\\).*"],
        },
        Plus: {
            ignoreSourceCodeByRegex: [".*\\(1\\.0 \\+ \\$c \\* \\$x\\).*"],
        },
        // Moving the top of the draw range by one unit in 2^53 is not observable,
        // and PHP_INT_SIZE cannot take its other branch on a 64-bit test runner.
        GreaterThanOrEqualTo: {
            ignoreSourceCodeByRegex: [".*PHP_INT_SIZE.*"],
        },
        LessThanOrEqualTo: {
            // v == 0.0 exactly has probability zero, and would loop forever on
            // log(0) if it ever happened — the boundary is unreachable either way.
            ignoreSourceCodeByRegex: [".*\\$v <= 0\\.0.*"],
        },
    },
}

{
    "name": "cleatsquad/php-bandit",
    "description": "Beta-Bernoulli Thompson Sampling multi-armed bandit, in dependency-free PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bandit",
        "multi-armed-bandit",
        "thompson-sampling",
        "beta-bernoulli",
        "reinforcement-learning",
        "statistics",
        "ab-testing"
    ],
    "homepage": "https://github.com/cleatSquad/php-bandit",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cleatSquad/php-bandit/issues",
        "source": "https://github.com/cleatSquad/php-bandit"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\Bandit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\Bandit\\Tests\\": "tests/",
            "CleatSquad\\Bandit\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "bench": [
            "@composer install --working-dir=tools/phpbench --no-interaction",
            "tools/phpbench/vendor/bin/phpbench run --report=aggregate"
        ],
        "mutation": [
            "@composer install --working-dir=tools/infection --no-interaction",
            "tools/infection/vendor/bin/infection --show-mutations --threads=max"
        ]
    },
    "scripts-descriptions": {
        "bench": "Runs the benchmark suite (installs the benchmark toolchain on first use).",
        "mutation": "Runs mutation testing (installs the toolchain on first use; needs pcov or xdebug)."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
